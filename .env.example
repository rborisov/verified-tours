# Auth.js / NextAuth — default port 3001 (newsdigest uses 3000)
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=change-me

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Yandex OAuth
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Comma-separated allowlist; seeded as admins
ALLOWED_EMAILS=admin@example.com

# Internal API key (worker + MCP → portal)
INTERNAL_API_KEY=change-me

# Same personal Cursor key as newsdigest is fine
CURSOR_API_KEY=

# Optional: absolute path to Cursor CLI binary (default: agent on PATH)
# CURSOR_CLI_PATH=/usr/local/bin/agent

# Agent working directory
AGENT_WORKSPACE=/opt/verified-tours/workspace

# Host-wide mutex file shared with newsdigest (one agent at a time)
AGENT_MUTEX_PATH=/var/lock/cursor-agent.lock

# Portal URL for MCP / worker callbacks
PORTAL_URL=http://127.0.0.1:3001

# SQLite (Prisma) — path relative to apps/web/prisma/schema.prisma
DATABASE_URL=file:./dev.db

# Disk alert thresholds (worker)
DISK_ALERT_USED_PCT=85
DISK_ALERT_COOLDOWN_HOURS=6
# Optional webhook (Telegram bot URL or similar)
# DISK_ALERT_WEBHOOK_URL=
