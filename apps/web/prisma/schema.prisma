generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SearchRequest {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  adults       Int
  childrenAges String   @default("")
  fromCity     String
  countries    String
  departFrom   DateTime
  departTo     DateTime
  nightsMin    Int      @default(7)
  nightsMax    Int      @default(7)
  seaRequired  Boolean  @default(true)
  visaFreeOnly Boolean  @default(true)
  preferHot    Boolean  @default(true)
  rawBrief     String?
  /// queued | running | awaiting_human | done | failed
  status       String   @default("queued")
  jobId        String?
  error        String?

  offers Offer[]
  job    AgentJob?
}

model Offer {
  id              String         @id @default(cuid())
  searchRequestId String?
  searchRequest   SearchRequest? @relation(fields: [searchRequestId], references: [id], onDelete: SetNull)

  /// hash(source + hotelId + fromCity + start + nights + party)
  fingerprint  String
  source       String
  hotelName    String
  hotelId      String?
  country      String
  resort       String?
  deepLink     String

  fromCity     String
  startDate    DateTime
  endDate      DateTime
  nights       Int
  adults       Int
  childrenAges String   @default("")
  listingPriceRub Int?
  pagePriceRub    Int?
  priceDriftPct   Float?
  hasFlight    Boolean  @default(true)
  seaNote      String?
  hotBadge     String?
  visaOk       Boolean  @default(true)

  /// none | L1 | L2 | L3
  autoLevel    String   @default("none")
  autoNotes    String?
  /// candidate | pending_human | verified | rejected | expired
  status       String   @default("candidate")
  rejectReason String?
  verifiedAt   DateTime?
  verifiedBy   String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([fingerprint])
  @@index([status, expiresAt])
  @@index([fromCity, startDate, country])
}

model AgentJob {
  id          String         @id @default(cuid())
  kind        String         @default("tour_search")
  /// queued | running | done | failed
  status      String         @default("queued")
  requestId   String?        @unique
  request     SearchRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  prompt      String?
  error       String?
  pid         Int?
  createdAt   DateTime       @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([status, createdAt])
}

model DiskAlert {
  id        String   @id @default(cuid())
  sentAt    DateTime @default(now())
  freeBytes BigInt
  usedPct   Float
  message   String
}

model AllowedUser {
  id        String   @id @default(cuid())
  email     String   @unique
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Auth.js Prisma adapter models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
